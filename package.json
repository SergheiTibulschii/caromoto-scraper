{
  "name": "caromoto-scraper",
  "version": "2.0.0",
  "description": "Automated Caromoto scraper with scheduled jobs and persistent storage",
  "main": "build/main.js",
  "scripts": {
    "build": "npx tsc -p .",
    "start": "ts-node src/main.ts",
    "start:dev": "ts-node src/main.ts dev",
    "start:prod": "node build/main.js",
    "start:prod:local": "npm run build && docker-compose up -d && sleep 3 && node build/main.js",
    "start:prod:ts": "docker-compose up -d && sleep 3 && ts-node src/main.ts",
    "start:once": "ts-node src/main.ts once",
    "stop:prod": "docker-compose down",
    "stats": "npm run build && ts-node src/main.ts stats",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f redis",
    "scrape:manual": "ts-node src/apps/scraper/caromoto-auth-mercedes-gle-scraper/index.ts",
    "telegram:get-chat-id": "ts-node src/apps/scraper/caromoto-auth-mercedes-gle-scraper/get-chat-id.ts",
    "telegram:test-bot": "ts-node src/apps/scraper/caromoto-auth-mercedes-gle-scraper/test-bot.ts",
    "test": "echo \"Error: no test specified\" && exit 1",
    "lint": "eslint 'src/**/*.{js,ts}'",
    "lint:fix": "eslint 'src/**/*.{js,ts}' --fix",
    "format": "prettier --write 'src/**/*.{js,ts,json}'",
    "prepare": "husky install"
  },
  "lint-staged": {
    "src/**/*.{js,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "src/**/*.{json,css,md,html,pug}": [
      "prettier --write"
    ]
  },
  "keywords": [
    "node.js",
    "express",
    "api",
    "typescript",
    "docker"
  ],
  "author": "Abdou-Raouf ATARMLA",
  "license": "ISC",
  "dependencies": {
    "dotenv": "^16.4.5",
    "ioredis": "^5.4.1",
    "node-cron": "^3.0.3",
    "node-telegram-bot-api": "^0.67.0",
    "playwright": "^1.58.2",
    "winston": "^3.13.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.35",
    "@types/node-cron": "^3.0.11",
    "@types/node-telegram-bot-api": "^0.64.14",
    "@typescript-eslint/eslint-plugin": "^5.57.1",
    "@typescript-eslint/parser": "^5.57.1",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-promise": "^6.2.0",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.7",
    "nodemon": "^3.1.3",
    "prettier": "^3.3.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.0.4"
  }
}
