# Production Environment Variables for Cloud Run
# Copy this file to .env.production and fill in your values
# DO NOT commit .env.production to git

# Application
NODE_ENV=production

# Redis Configuration (Recommended: Upstash Redis for serverless)
# Get free Redis at: https://upstash.com/
REDIS_HOST=your-redis-host.upstash.io
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password
REDIS_DB=0
REDIS_KEY_PREFIX=caromoto:
REDIS_ENABLE_PERSISTENCE=true
REDIS_MAX_RETRIES=5
REDIS_RETRY_DELAY=2000

# Scheduler Configuration
SCHEDULER_ENABLED=true
# Run every 5 minutes: */5 * * * *
# Run every hour: 0 * * * *
# Run twice a day at 9 AM and 9 PM: 0 9,21 * * *
SCRAPER_CRON_SCHEDULE=*/5 * * * *
SCHEDULER_TIMEZONE=Europe/Chisinau
SCRAPER_RUN_ON_START=true

# Caromoto Credentials
CAROMOTO_EMAIL=your-email@example.com
CAROMOTO_PASSWORD=your-password

# Playwright Browser Configuration (Optimized for Cloud Run)
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_BROWSER=chromium
PLAYWRIGHT_TIMEOUT=30000
PLAYWRIGHT_NAVIGATION_TIMEOUT=60000
PLAYWRIGHT_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36
PLAYWRIGHT_VIEWPORT_WIDTH=1920
PLAYWRIGHT_VIEWPORT_HEIGHT=1080
# Reduced for Cloud Run memory constraints
PLAYWRIGHT_MAX_CONCURRENT_PAGES=3

# Proxy Configuration (optional, leave empty if not using proxy)
PLAYWRIGHT_PROXY_SERVER=
PLAYWRIGHT_PROXY_USERNAME=
PLAYWRIGHT_PROXY_PASSWORD=

# Anti-detection
PLAYWRIGHT_STEALTH_MODE=true

# Telegram Bot Configuration
# Get bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your-bot-token
# Get chat ID by sending a message to your bot and visiting:
# https://api.telegram.org/bot<YOUR_BOT_TOKEN>/getUpdates
TELEGRAM_CHAT_ID=your-chat-id

# Cloud Run Configuration (automatically set by Cloud Run)
# PORT=8080

# Note: For production deployment on Cloud Run, it's recommended to use
# Google Cloud Secret Manager instead of environment variables for sensitive data.
# See DEPLOYMENT.md for instructions on setting up secrets.
